<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: its own first screen shows the same small crown as the app's opening screen -->
    <style name="Launch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
