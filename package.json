{
  "name": "narmac-desktop",
  "productName": "Narmac Societe",
  "version": "1.0.4",
  "description": "Narmac Societe stock app for Windows",
  "author": "Narmac Societe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.narmacsociete.stockbook",
    "productName": "Narmac Societe",
    "copyright": "Narmac Societe",
    "files": [
      "main.js",
      "offline.html",
      "package.json",
      "build/icon.ico"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Narmac Societe",
      "artifactName": "Narmac-Societe-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blacpeaz",
        "repo": "narmac-desktop",
        "releaseType": "release"
      }
    ]
  }
}
